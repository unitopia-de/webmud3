  "scripts": {
    "prebuild": "npm run build --workspace @webmud3/shared",
    "build": "ng build",
    "build:prod": "ng build --configuration=production",
    "clean:dist": "npx rimraf dist",
    "clean:packages": "npx rimraf node_modules",
    "format": "prettier --write \"src/**/*.ts\"",
    "ng": "ng",
    "start": "ng serve",
    "start:intranet": "ng serve --host 0.0.0.0",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix"
  },
  "private": true,
  "dependencies": {
    "@angular-eslint/schematics": "~20.3.0",
