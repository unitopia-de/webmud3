    "@angular-eslint/template-parser": "~21.4.0",
    "@angular/build": "^21.2.13",
    "@angular/cli": "~21.2.13",
    "@angular/compiler-cli": "~21.2.14",
    "@types/jest": "~30.0.0",
    "@types/node": "~24.7.2",
    "@typescript-eslint/eslint-plugin": "~8.46.0",
    "@typescript-eslint/parser": "~8.46.0",
    "eslint": "~9.37.0",
    "eslint-plugin-import": "~2.32.0",
