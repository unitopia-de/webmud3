{
  "name": "@webmud3/backend",
  "version": "1.0.0-alpha",
  "description": "Webmud3 Backend Service",
  "type": "module",
  "authors": ["Myonara", "Felag"],
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "~22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/unitopia-de/webmud3.git"
  },
  "main": "main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run build --workspace @webmud3/shared",
    "build": "npm run clean:dist && tsc",
    "build:watch": "npm run clean:dist && tsc --watch",
    "clean": "npm run clean:dist && npm run clean:packages",
    "clean:dist": "npx rimraf dist",
    "clean:packages": "npx rimraf node_modules",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint ./src --ext .ts",
    "lint:fix": "eslint ./src --ext .ts --fix",
    "postbuild": "npx cpy package.json dist",
    "start": "npm run build && node dist/main.js",
    "serve": "node dist/main.js",
    "test": "jest --config=jest.config.cjs"
  },
  "dependencies": {
    "@webmud3/shared": "1.0.0-alpha",
    "body-parser": "~2.2.0",
    "cors": "~2.8.5",
    "dotenv": "~17.2.3",
    "express": "~5.1.0",
    "socket.io": "~4.8.1",
    "source-map-support": "~0.5.21",
    "telnet-stream": "~1.1.0",
    "url": "~0.11.4",
    "uuid": "~13.0.0",
    "winston": "~3.18.3"
  },
  "devDependencies": {
    "@types/express": "~5.0.3",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.18.10",
    "@types/source-map-support": "~0.5.10",
    "@types/uuid": "~11.0.0",
    "@typescript-eslint/eslint-plugin": "~8.46.0",
    "@typescript-eslint/parser": "~8.46.0",
    "cpy-cli": "~6.0.0",
    "eslint": "~8.57.1",
    "eslint-config-standard": "~17.1.0",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-node": "~11.1.0",
    "eslint-plugin-simple-import-sort": "~12.1.1",
    "jest": "~30.2.0",
    "prettier": "~3.6.2",
    "rimraf": "~6.0.1",
    "ts-jest": "~29.4.5",
    "ts-jest-mock-import-meta": "~1.3.1",
    "typescript": "~5.9.3"
  }
}
